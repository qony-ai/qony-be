QONY_ENVIRONMENT=development
QONY_APP_LOG_LEVEL=INFO
QONY_DATABASE_URL=postgresql+psycopg://qony:qony@localhost:5432/qony
QONY_DATABASE_POOL_SIZE=10
QONY_DATABASE_MAX_OVERFLOW=20
QONY_DATABASE_POOL_TIMEOUT_SECONDS=30
QONY_DATABASE_POOL_RECYCLE_SECONDS=1800
QONY_API_V1_PREFIX=/api/v1
QONY_CORS_ORIGINS=["http://localhost:3000"]
QONY_REQUEST_ID_HEADER=X-Request-ID
QONY_ACTOR_EMAIL_HEADER=X-User-Email
QONY_ACTOR_NAME_HEADER=X-User-Name
QONY_ALLOW_DEFAULT_ACTOR=true
QONY_DEFAULT_USER_EMAIL=local@qony.ai
QONY_DEFAULT_USER_NAME=Local Developer
QONY_API_DOCS_ENABLED=true

QONY_AI_PROVIDER=stub
QONY_AI_FALLBACK_TO_STUB=true
QONY_AI_REQUEST_TIMEOUT_SECONDS=20

QONY_OLLAMA_BASE_URL=http://localhost:11434
QONY_OLLAMA_MODEL=qwen3:8b

QONY_REMOTE_AI_BASE_URL=https://api.openai.com/v1
QONY_REMOTE_AI_API_KEY=
QONY_REMOTE_AI_MODEL=gpt-4.1-mini
