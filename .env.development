# Development AI mode for OpenAI-backed integration.
AI_MODE=development
OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_MODEL_EXTRACTION=gpt-4o-mini
OPENAI_MODEL_GENERATION=gpt-4o
OPENAI_MODEL_SCRAPING=gpt-4o-mini

# Midtrans placeholders for platform work.
MIDTRANS_SERVER_KEY=SB-Mid-server-replace-me
MIDTRANS_CLIENT_KEY=SB-Mid-client-replace-me
MIDTRANS_IS_PRODUCTION=false

# Existing backend settings continue to use the QONY_ prefix.
QONY_ENVIRONMENT=development
QONY_DATABASE_URL=postgresql+psycopg://qony:qony@localhost:5432/qony
QONY_API_V1_PREFIX=/api/v1
QONY_CORS_ORIGINS=["http://localhost:3000"]
QONY_REQUEST_ID_HEADER=X-Request-ID
QONY_INTERNAL_ACTOR_SECRET=replace-with-a-shared-secret
QONY_INTERNAL_ACTOR_ISSUER=qony-fe
QONY_INTERNAL_ACTOR_AUDIENCE=qony-be
QONY_ALLOW_HEADER_ACTOR_FALLBACK=true
QONY_ALLOW_DEFAULT_ACTOR=true
